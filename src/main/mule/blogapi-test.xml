										<set-variable value="404" doc:name="HTTP 404 - Not Found User" doc:id="8175eee5-42aa-49b6-9f8f-fbf0c4aa0e78" variableName="httpStatus" />
									</when>
									<otherwise >
										<logger level="INFO" doc:name="Logger" doc:id="6613cac7-9efd-416c-9c5b-ece43dd6d7f9" message="#[&quot;PATCH:\\user\\(user-id): User with $(vars.id as String default 'N/A') ID was successfully updated and checked&quot;]" />
										<set-variable value="201" doc:name="HTTP 200" doc:id="4e957654-cc23-4a1c-b561-27f60e0e8068" variableName="httpStatus" />
									</otherwise>
								</choice>
								<ee:transform doc:name="Return Response with Data" doc:id="7b46b5d8-2555-458a-affe-1226c237b764" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var user_found = vars.httpStatus != "404"
---
{
	success: (user_found),
	message: if (user_found) "user data successfully updated" else "user not found",
	users: if (user_found) {id: payload[0].id, name: payload[0].name} else {} 
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</otherwise>
						</choice>
					</otherwise>
				</choice>
			</otherwise>
