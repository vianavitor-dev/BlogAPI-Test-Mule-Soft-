						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	success: false,
	message: "Error when trying to receive the ID",
	users: []
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise>
				<choice doc:name="Choice" doc:id="1a0b05b3-f6c6-4be5-b3ef-3a9329078f05">
			<when expression="#[isBlank(payload.name)]">
						<logger level="WARN" doc:name="Logger" doc:id="c1cd98e0-6a2b-4759-9376-71ac35386882" message="PUT:\user\(user-id): Missing name into the payload body" />
						<set-variable value="400" doc:name="HTTP 400" doc:id="b0f0984e-13c9-4dfd-a9fe-03e0253f97c9" variableName="httpStatus" />
						<ee:transform doc:name="Missing Name" doc:id="066efb6c-2496-4fd7-ab9c-615b7e3b4268">
							<ee:message>
								<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	success: false,
	message: "Please enter the new name"
}
	
]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise>
				<db:update doc:name="Update" doc:id="0c0eb12c-a330-4a1f-97c9-965a15ee8ffe" config-ref="Database_Config" autoGenerateKeys="true">
					<db:sql><![CDATA[UPDATE user SET name = :name WHERE id = :id]]></db:sql>
					<db:input-parameters><![CDATA[#[{
	name: payload.name,
	id: attributes.uriParams."user-id"
}]]]></db:input-parameters>
				</db:update>
						<set-variable value="#[payload.generatedKeys.GENERATED_KEY default 0]" doc:name="Set ID (User ID after update)" doc:id="a128aa58-0be5-484f-8fdc-d0d8ca21a841" variableName="id" />
						<choice doc:name="Choice" doc:id="5b204da3-30cc-4e74-86e7-6c70af5015d5">
							<when expression="#[vars.id &lt;= 0]">
								<logger level="WARN" doc:name="Logger" doc:id="d633c19e-3072-4cd1-9077-3f4153214c7a" message="PUT:\user\(user-id): Error when getting registered User's ID" />
								<ee:transform doc:name="Missing User ID" doc:id="d11cf1ff-aa12-46c2-9f5c-20ef832dbfe9">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  data: null,
  success: true,
  message: "User successfully created"
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</when>
							<otherwise >
								<logger level="INFO" doc:name="Logger" doc:id="aa0f2141-8a5c-4751-aefa-77ac96340472" message="#[&quot;PUT:\\user\\(user-id): Searching for the user with $(vars.id as String default 'N\A')&quot;]" />
								<db:select doc:name="Select" doc:id="0833659b-d642-4748-b723-26c6866cce1d" config-ref="Database_Config" >
									<db:sql ><![CDATA[SELECT id, name FROM user WHERE id = :id LIMIT 1]]></db:sql>
									<db:input-parameters ><![CDATA[#[{
	id: vars.id
}]]]></db:input-parameters>
								</db:select>
								<choice doc:name="Choice" doc:id="72c2097a-dba0-4513-a5eb-0032467a5861" >
									<when expression="#[isEmpty(payload)]" >
										<logger level="WARN" doc:name="Logger" doc:id="94de5fae-d647-4ef7-80b0-a325406a839f" message="PUT:\user\(user-id): User was not found after the update" />
										<set-variable value="404" doc:name="HTTP 404 - Not Found User" doc:id="a265ce45-9407-4392-b7b2-b3d5c87e343a" variableName="httpStatus" />
									</when>
									<otherwise >
										<logger level="INFO" doc:name="Logger" doc:id="dd3c2379-9127-4e36-aba8-98bcd8178e11" message="#[&quot;PUT:\\user\\(user-id): User with $(vars.id as String default 'N/A') ID was successfully updated and checked&quot;]" />
										<set-variable value="201" doc:name="HTTP 200" doc:id="da93c03f-9287-46dc-aff9-cc424ede8963" variableName="httpStatus" />
									</otherwise>
								</choice>
								<ee:transform doc:name="Return Response with Data" doc:id="c8b24df6-4c8d-45bd-8c29-588ceb21be9d" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var user_found = vars.httpStatus != "404"
---
{
	success: (user_found),
	message: if (user_found) "user data successfully updated" else "user not found",
	users: if (user_found) {id: payload[0].id, name: payload[0].name} else {} 
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</otherwise>
						</choice>
			</otherwise>
		</choice>
			</otherwise>
		</choice>
    </flow>
